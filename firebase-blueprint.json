{
  "entities": {
    "app_config": {
      "title": "App Config",
      "description": "Global application configuration and admin PIN",
      "type": "document",
      "path": "app_config/main",
      "fields": {
        "adminPin": { "type": "string", "description": "PIN password for Admin access" },
        "title": { "type": "string", "description": "App main title" },
        "subtitle": { "type": "string", "description": "App subtitle" },
        "logoUrl": { "type": "string", "description": "Logo URL" },
        "demoMode": { "type": "boolean", "description": "Demo mode flag" },
        "allowDuplicates": { "type": "boolean", "description": "Allow duplicate winners" },
        "soundEnabled": { "type": "boolean", "description": "Sound toggle" }
      }
    },
    "employees": {
      "title": "Employees",
      "description": "List of participants/employees for lucky spin",
      "type": "collection",
      "path": "employees",
      "fields": {
        "name": { "type": "string", "description": "Employee full name" },
        "email": { "type": "string", "description": "Employee ID or email" },
        "department": { "type": "string", "description": "Department or branch" }
      }
    },
    "prizes": {
      "title": "Prizes",
      "description": "List of prizes for the event",
      "type": "collection",
      "path": "prizes",
      "fields": {
        "name": { "type": "string", "description": "Prize name" },
        "quantity": { "type": "number", "description": "Total quantity" },
        "remainQuantity": { "type": "number", "description": "Remaining quantity" },
        "order": { "type": "number", "description": "Display order" }
      }
    },
    "winners": {
      "title": "Winners",
      "description": "Recorded winner logs",
      "type": "collection",
      "path": "winners",
      "fields": {
        "employeeId": { "type": "string", "description": "Winner employee ID" },
        "employeeName": { "type": "string", "description": "Winner name" },
        "department": { "type": "string", "description": "Winner department" },
        "prizeId": { "type": "string", "description": "Prize ID won" },
        "prizeName": { "type": "string", "description": "Prize name won" },
        "wonAt": { "type": "string", "description": "Timestamp of winning" }
      }
    }
  }
}
